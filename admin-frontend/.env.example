PORT=3001
BROWSER=none

# Khi dùng domain riêng: sửa localhost thành domain của bạn (ví dụ https://api.yourdomain.com hoặc https://yourdomain.com/api)
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_SOCKET_URL=http://localhost:5000
REACT_APP_CUSTOMER_URL=http://localhost:3000

# Tắt SourceMap để bảo vệ mã nguồn khi build production (tránh lộ code gốc JSX trong F12)
GENERATE_SOURCEMAP=false

