PORT=5000
# Bắt buộc: điền thông tin MySQL của môi trường đang triển khai.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Bắt buộc: dùng chuỗi ngẫu nhiên mạnh, không dùng giá trị mẫu khi production.
JWT_SECRET=
# URL frontend được phép truy cập API (có thể dùng localhost khi phát triển cục bộ).
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

